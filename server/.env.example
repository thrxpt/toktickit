# Copy to server/.env before starting anything:
#   cp server/.env.example server/.env
#
# One file, two readers: compose.yaml loads it via env_file to configure the
# Postgres container, and Prisma/Express read it for DATABASE_URL and PORT.
# Values below work as-is for local development. server/.env is git-ignored.

# Postgres container
POSTGRES_USER=toktickit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=toktickit

# Prisma + Express
DATABASE_URL="postgresql://toktickit:change-me@localhost:5432/toktickit?schema=public"
PORT=3000
