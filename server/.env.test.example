# Copy to server/.env.test to point API tests at their own database:
#   cp server/.env.test.example server/.env.test
#
# Optional. Without this file the test run derives the same URL from
# server/.env, swapping the database name for toktickit_test — so a clean
# clone needs no manual step. Copy it when your Postgres credentials differ
# from server/.env's, or when the test database lives elsewhere.
#
# toktickit_test is a second database inside the one Postgres container
# compose.yaml runs (ADR-0001); the test run creates it if it is absent.
# server/.env.test is git-ignored, exactly like server/.env.

DATABASE_URL="postgresql://toktickit:change-me@localhost:5432/toktickit_test?schema=public"
