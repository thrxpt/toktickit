// TokTickIT data model.
// The connection URL lives in prisma.config.ts, which reads DATABASE_URL from
// server/.env — see prisma/config docs: https://pris.ly/prisma-config

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Exactly the three values BR-14 names. There is no server default: the
// Requester states a priority or the request fails validation.
enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
}

// IT Priority managed by IT Staff / Admin (BR-20).
enum ITPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Role for users in TokTickIT (BR-13, ADR-0008).
enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

// Ticket status lifecycle values (BR-21, BR-22).
enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role     @default(REQUESTER)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  submittedTickets    Ticket[]     @relation("TicketRequester")
  ownedTickets        Ticket[]     @relation("TicketOwner")
  uploadedAttachments Attachment[] @relation("AttachmentUploader")
  removedAttachments  Attachment[] @relation("AttachmentRemover")
  comments            Comment[]
  internalNotes       InternalNote[]

  @@index([role, isActive])
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

model Ticket {
  id           Int    @id @default(autoincrement())
  ticketNumber String @unique

  requesterId     Int
  requester       User          @relation("TicketRequester", fields: [requesterId], references: [id])
  ticketOwnerId   Int?
  ticketOwner     User?         @relation("TicketOwner", fields: [ticketOwnerId], references: [id], onDelete: Restrict)
  categoryId      Int
  category        Category      @relation(fields: [categoryId], references: [id])
  relatedSystemId Int
  relatedSystem   RelatedSystem @relation(fields: [relatedSystemId], references: [id])

  summary     String
  description String

  requestedPriority   RequestedPriority
  itPriority          ITPriority        @default(LOW)
  status              TicketStatus      @default(NEW)
  resolvedByRequester Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments   Attachment[]
  comments      Comment[]
  internalNotes InternalNote[]

  @@index([requesterId, createdAt(sort: Desc)])
  @@index([categoryId])
  @@index([status])
  @@index([requestedPriority])
  @@index([ticketOwnerId, status])
  @@index([itPriority, status])
}

model Attachment {
  id       Int    @id @default(autoincrement())
  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  originalFilename String
  mimeType         String
  sizeBytes        Int
  storageKey       String @unique

  uploadedById Int
  uploadedBy   User     @relation("AttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  removedAt     DateTime?
  removedById   Int?
  removedBy     User?    @relation("AttachmentRemover", fields: [removedById], references: [id], onDelete: Restrict)
  removalReason String?

  @@index([ticketId, removedAt])
}

model Comment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  content   String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt(sort: Asc)])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  content   String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt(sort: Asc)])
}
